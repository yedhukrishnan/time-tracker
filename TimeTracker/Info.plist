<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- User-facing app name (notifications, login items, About). -->
	<key>CFBundleDisplayName</key>
	<string>Time Tracker</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>

	<!-- Run as a background agent: no Dock icon, no app menu, just the status bar item. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Updates (Sparkle). The feed is the appcast.xml attached to the latest
	     GitHub release; updates are verified against SUPublicEDKey (private
	     half lives in the release Mac's Keychain — see BUILDING.md).
	     Checks are daily; downloading/installing always asks first
	     (SUAutomaticallyUpdate is off). -->
	<key>SUFeedURL</key>
	<string>https://github.com/yedhukrishnan/time-tracker/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>VtH+9Dn7dgJK/0KgOUTNfuNM2o+eJkir113x9734+ME=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<!-- Sandboxed app: the installer runs out-of-process via Sparkle's XPC
	     launcher service (needs the mach-lookup entitlement exception). -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>

	<!-- Note: CloudKit push on macOS comes from the Push Notifications capability
	     (aps-environment), not a background mode. The iOS "remote-notification"
	     UIBackgroundModes key does not apply to macOS. -->
</dict>
</plist>
